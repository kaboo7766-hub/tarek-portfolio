rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function isOwner(){return request.auth != null && request.auth.token.email == 'kaboo7766@gmail.com' && request.auth.token.email_verified == true;}
  match /portfolio/{allPaths=**}{allow read:if true;allow create,update:if isOwner() && request.resource.size < 8*1024*1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');allow delete:if isOwner();}
 }
}