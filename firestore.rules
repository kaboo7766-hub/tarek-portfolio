rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isOwner(){return request.auth != null && request.auth.token.email == 'kaboo7766@gmail.com' && request.auth.token.email_verified == true;}
  match /projects/{id}{allow read:if true;allow create,update,delete:if isOwner();}
  match /settings/{id}{allow read:if id == 'profile';allow write:if isOwner() && id == 'profile';}
  match /{document=**}{allow read,write:if false;}
 }
}